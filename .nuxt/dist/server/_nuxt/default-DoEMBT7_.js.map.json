AA,EAAK,MAAM,CAAA,8EAAAK,cACjB,QAAML,MAAA,IAAA,EAAK,QAAQ,CAAA,iKAAA;AAAA;;;;;;;;;;;;;;;ACTxB,QAAA,OAAAL,eAAAC,WAAA,EAAA,OAAM,qFAAiF,MAAA,CAAA,CAAA,GAAA;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_ssrInterpolate","_unref","_createTextVNode","_toDisplayString","_ssrRenderList","_ssrRenderClass","_ssrRenderAttr"],"sources":["../../../../data/site.ts","../../../../components/SiteHeader.vue","../../../../components/ActivityRail.vue","../../../../components/SiteFooter.vue","../../../../layouts/default.vue"],"sourcesContent":["export const SITE = {\n  name: 'Bibi Aremieye',\n  github: 'https://github.com/Bibi1989',\n  linkedin: 'https://www.linkedin.com/in/bibirinbulu-aremieye-983831175/',\n  email: 'bibirinbulu.aremieye@gmail.com'\n} as const\n\nexport const NAV = [\n  { href: '/dashboard', label: 'Profile' },\n  { href: '/case-studies', label: 'Projects' },\n  { href: '/about', label: 'Stack' },\n  { href: '/', label: 'Archive' },\n  { href: '/analytics', label: 'Insights' }\n] as const\n","<script setup lang=\"ts\">\nimport { NAV, SITE } from '~/data/site'\n\nconst route = useRoute()\nconst { toggleTheme } = useThemeToggle()\n\nconst isActive = (href: string) => {\n  if (href === '/') return route.path === '/'\n  return route.path.startsWith(href)\n}\n</script>\n\n<template>\n  <header class=\"sticky top-0 z-50 border-b border-primary/15 bg-header-bg shadow-dock backdrop-blur-3xl\">\n    <nav class=\"mx-auto flex w-full max-w-screen-2xl flex-wrap items-center justify-between gap-3 px-6 py-4\">\n      <NuxtLink to=\"/\" class=\"font-headline text-lg font-black tracking-tighter text-primary\">{{ SITE.name }}</NuxtLink>\n      <div class=\"hidden items-center gap-8 font-headline text-sm font-bold tracking-tight md:flex\">\n        <NuxtLink\n          v-for=\"item in NAV\"\n          :key=\"item.href\"\n          :to=\"item.href\"\n          class=\"transition-all duration-300\"\n          :class=\"isActive(item.href) ? 'border-b-2 border-primary pb-1 text-primary' : 'text-primary/60 hover:text-primary'\"\n        >\n          {{ item.label }}\n        </NuxtLink>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <a :href=\"SITE.linkedin\" target=\"_blank\" rel=\"noreferrer\" class=\"rounded-lg p-2 text-primary hover:bg-primary/10\">in</a>\n        <a :href=\"SITE.github\" target=\"_blank\" rel=\"noreferrer\" class=\"rounded-lg p-2 text-primary hover:bg-primary/10\">gh</a>\n        <button type=\"button\" class=\"rounded-lg p-2 text-primary hover:bg-primary/10\" @click=\"toggleTheme\">theme</button>\n      </div>\n    </nav>\n  </header>\n</template>\n","<script setup lang=\"ts\">\nconst { activityTab } = useUiState()\n\nconst tabs = ['commits', 'status', 'network', 'logs'] as const\nconst feeds = {\n  commits: [\n    { meta: 'COMMIT: 7ae91c0', time: '2M AGO', body: 'feat: concurrent worker pool for stream processing' },\n    { meta: 'PR: #452', time: '1H AGO', body: 'merged: core architecture redesign (alpha)' }\n  ],\n  status: [{ meta: 'CLUSTER', time: 'LIVE', body: 'Node Cluster 04: 99.98% efficiency' }],\n  network: [{ meta: 'LATENCY', time: '4MS', body: 'Edge POP — fra1 ↔ iad1' }],\n  logs: [{ meta: 'AUTH', time: 'NOW', body: 'Access granted to secure-archive-v2' }]\n}\n</script>\n\n<template>\n  <aside class=\"fixed right-0 top-0 z-40 hidden h-full w-80 flex-col border-l border-primary/10 bg-surface-container-low xl:flex\">\n    <div class=\"border-b border-surface p-6 xl:mt-20\">\n      <h3 class=\"font-headline text-sm font-bold tracking-tight text-secondary\">Activity Stream</h3>\n      <p class=\"font-mono text-[10px] uppercase tracking-widest text-primary/40\">Real-time technical updates</p>\n    </div>\n    <div class=\"space-y-1 p-2 font-mono text-xs\">\n      <button\n        v-for=\"tab in tabs\"\n        :key=\"tab\"\n        type=\"button\"\n        class=\"flex w-full items-center gap-3 rounded-md px-4 py-3 text-left transition-colors\"\n        :class=\"activityTab === tab ? 'border-l-2 border-secondary bg-secondary/10 text-secondary' : 'text-primary/40 hover:bg-primary/5'\"\n        @click=\"activityTab = tab\"\n      >\n        {{ tab }}\n      </button>\n    </div>\n    <div class=\"space-y-6 p-6\">\n      <div v-for=\"row in feeds[activityTab]\" :key=\"row.meta + row.time\" class=\"space-y-2\">\n        <div class=\"flex justify-between text-[10px] text-primary/30\"><span>{{ row.meta }}</span><span>{{ row.time }}</span></div>\n        <p class=\"text-sm text-primary/80\">{{ row.body }}</p>\n      </div>\n    </div>\n  </aside>\n</template>\n","<script setup lang=\"ts\">\nimport { SITE } from '~/data/site'\n</script>\n\n<template>\n  <footer class=\"border-t border-primary/10 bg-footer-bg\">\n    <div class=\"mx-auto flex w-full max-w-6xl flex-col gap-4 px-8 py-4 font-mono text-[10px] uppercase tracking-widest text-primary/50 sm:flex-row sm:items-center sm:justify-between\">\n      <div>© 2026 Bibi Aremieye · Hamburg, Germany</div>\n      <div class=\"flex items-center gap-6\">\n        <a :href=\"SITE.github\" target=\"_blank\" rel=\"noreferrer\" class=\"hover:text-secondary\">GitHub</a>\n        <a :href=\"SITE.linkedin\" target=\"_blank\" rel=\"noreferrer\" class=\"hover:text-secondary\">LinkedIn</a>\n        <span class=\"text-secondary\">Available for opportunities</span>\n      </div>\n    </div>\n  </footer>\n</template>\n","<template>\n  <div class=\"min-h-screen bg-background font-body text-on-background selection:bg-primary/30\">\n    <SiteHeader />\n    <ActivityRail />\n    <div class=\"flex min-h-[calc(100vh-4rem)] flex-col xl:mr-80\">\n      <div class=\"flex-1\">\n        <slot />\n      </div>\n      <SiteFooter />\n    </div>\n  </div>\n</template>\n"],"version":3}